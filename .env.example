# Phase 8: example environment configuration for the Fraud Risk Decision
# API container. Copy to `.env` and adjust if needed — this file contains
# NO real secrets (this local service does not require any).

# Bind address/port INSIDE the container's uvicorn process.
API_HOST=0.0.0.0
API_PORT=8000

# Whether to warm-start behavioral state from TRAIN+VALIDATION history at
# startup. Requires the raw train_transaction.csv, which is NOT copied
# into the Docker image (see .dockerignore) — so this should stay "false"
# for the containerized service. Set to "true" only if you have mounted
# the raw dataset into the container yourself (not done by default).
WARM_START_STATE=false

# Informational only — does not change application behavior.
APP_ENV=container
